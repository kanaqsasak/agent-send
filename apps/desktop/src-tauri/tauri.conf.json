{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agent-send",
  "version": "0.1.0",
  "identifier": "com.agent-send.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "agent-send",
        "width": 396,
        "height": 540,
        "resizable": false,
        "decorations": false,
        "shadow": true,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Private local file transfer",
    "longDescription": "A private, local-first file transfer tray service.",
    "externalBin": [
      "binaries/agent-send-daemon",
      "binaries/agent-send-cli",
      "binaries/agent-send-mcp"
    ],
    "resources": [
      "binaries/agent-send-daemon-*",
      "binaries/agent-send-cli-*",
      "binaries/agent-send-mcp-*"
    ],
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"] }
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
